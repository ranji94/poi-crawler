# Google Maps API Configuration
# Create a Google Cloud Platform project and enable:
# 1. Places API (Legacy) - NOT "Places API (New)"
# 2. Distance Matrix API
GMAPS_API_KEY=your_google_maps_api_key_here

# API Rate Limits (requests per minute)
# These help prevent hitting Google Maps quota limits
GMAPS_PLACES_RATE_LIMIT=150
GMAPS_DISTANCE_RATE_LIMIT=500

# Server Configuration
PORT=15010

# API Options
# Set to 'true' to skip extra API calls to reduce usage costs
NO_EXTRA_CALLS=false

# OpenStreetMap / Overpass API Configuration
# Public endpoint – no API key required.
# You can self-host Overpass or use a mirror if the default is slow.
# Default: https://overpass-api.de/api/interpreter
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Timeout in milliseconds for Overpass API requests (default: 30000 = 30 s)
OSM_TIMEOUT_MS=30000

# Caching Configuration
# Enable/disable in-memory caching (true/false)
ENABLE_CACHE=true

# Cache TTL values in minutes
CACHE_PLACES_TTL_MINS=1440  # 24 hours
CACHE_DISTANCE_TTL_MINS=360 # 6 hours
CACHE_OSM_TTL_MINS=1440     # 24 hours

# Retry Configuration
# Maximum number of retry attempts for API calls
MAX_RETRY_ATTEMPTS=3

# Initial backoff time in milliseconds (will increase exponentially)
RETRY_BACKOFF_MS=1000
